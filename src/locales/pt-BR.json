  "valueRules": {
    "timeParts": [
      {
        "pattern": "\\b1 days?",
        "flags": "g",
        "template": "1 dia"
      },
      {
        "pattern": "(\\d+) days?",
        "flags": "g",
        "template": "{1} dias"
      },
      {
        "pattern": "\\b1 hours?",
        "flags": "g",
        "template": "1 hora"
      },
      {
        "pattern": "(\\d+) hours?",
        "flags": "g",
        "template": "{1} horas"
      },
      {
        "pattern": "\\b1 minutes?",
        "flags": "g",
        "template": "1 minuto"
      },
      {
        "pattern": "(\\d+) minutes?",
        "flags": "g",
        "template": "{1} minutos"
      },
      {
        "pattern": "\\b1 seconds?",
        "flags": "g",
        "template": "1 segundo"
      },
      {
        "pattern": "(\\d+) seconds?",
        "flags": "g",
        "template": "{1} segundos"
      }
    ]
  }
