{
  "$schema": "./locale.schema.json",
  "language": "zh-Hant",
  "name": "繁體中文",
  "englishName": "Traditional Chinese",
  "htmlLang": "zh-Hant",
  "dir": "ltr",
  "punctuation": {
    ":": "：",
    "?": "？",
    "!": "！"
  },
  "punctuationSkipSuffixes": [
    "...",
    "…",
    "：",
    "？",
    "！"
  ],
  "patterns": [
    {
      "id": "thoughtFor",
      "pattern": "^Thought for (\\d+(?:\\.\\d+)?)(s|m|h|ms)$",
      "flags": "i",
      "template": "思考了 {1}{2}",
      "replace": {
        "2": "durationUnit"
      },
      "sample": "Thought for 5s"
    },
    {
      "id": "workedFor",
      "pattern": "^Worked for (\\d+(?:\\.\\d+)?)(s|m|h|ms)$",
      "flags": "i",
      "template": "運行了 {1}{2}",
      "replace": {
        "2": "durationUnit"
      },
      "sample": "Worked for 12.25m"
    },
    {
      "id": "selectModel",
      "pattern": "^Select model,\\s*current:\\s*(.+)$",
      "flags": "i",
      "template": "選擇模型，當前：{1}",
      "sample": "Select model, current: Gemini 3.1 Pro (High)"
    },
    {
      "id": "aiCredits",
      "pattern": "^Available AI Credits:\\s*(\\d+)$",
      "flags": "i",
      "template": "可用 AI 額度：{1}",
      "sample": "Available AI Credits: 12345"
    },
    {
      "id": "customizationBudget",
      "pattern": "^(\\d+(?:\\.\\d+)?\\s*%)\\s+of\\s+the\\s+customization\\s+budget\\s+is\\s+available(\\.?)$",
      "flags": "i",
      "template": "可用自定義預算額度為 {1}{2}",
      "replace": {
        "2": "period"
      },
      "sample": "94.4 % of the customization budget is available."
    },
    {
      "id": "customizationBudgetSuffix",
      "pattern": "^%\\s+of\\s+the\\s+customization\\s+budget\\s+is\\s+available(\\.?)$",
      "flags": "i",
      "template": "% 的自定義預算可用{1}",
      "replace": {
        "1": "period"
      },
      "sample": "% of the customization budget is available."
    },
    {
      "id": "showBreakdowns",
      "pattern": "^Show (\\d+) breakdowns?$",
      "flags": "i",
      "template": "顯示 {1} 個明細",
      "sample": "Show 12 breakdowns"
    },
    {
      "id": "toolsEnabled",
      "pattern": "^(\\d+) tools? enabled$",
      "flags": "i",
      "template": "已啓用 {1} 個工具",
      "sample": "9 tools enabled"
    },
    {
      "id": "learnMoreAbout",
      "pattern": "^Learn more about (.+)$",
      "flags": "i",
      "template": "瞭解更多關於 {1}",
      "replace": {
        "1": "preset"
      },
      "trimGroups": [
        1
      ],
      "sample": "Learn more about Security Preset"
    },
    {
      "id": "sendFeedbackAs",
      "pattern": "^Send feedback as (.+)$",
      "flags": "i",
      "template": "以 {1} 身份發送反饋",
      "sample": "Send feedback as user@example.com"
    },
    {
      "id": "quotaRefresh",
      "pattern": "^You have used some of your (weekly limit|5-hour limit), it will fully refresh in (.+)\\.$",
      "flags": "i",
      "template": "您已使用了部分{1}，將在 {2} 後完全刷新。",
      "replace": {
        "1": "limitType",
        "2": "timeParts"
      },
      "sample": "You have used some of your weekly limit, it will fully refresh in 2 days, 3 hours."
    },
    {
      "id": "loadOlderMessages",
      "pattern": "^Load older messages, showing (\\d+) of (\\d+)$",
      "flags": "i",
      "template": "加載更早的消息，當前顯示 {1} / {2} 條",
      "sample": "Load older messages, showing 20 of 100"
    },
    {
      "id": "tasksRunning",
      "pattern": "^(\\d+) tasks? running$",
      "flags": "i",
      "template": "{1} 個任務正在運行",
      "sample": "7 tasks running"
    },
    {
      "id": "seeAll",
      "pattern": "^See all \\(([\\d,]+)\\)$",
      "flags": "i",
      "template": "查看全部（{1}）",
      "sample": "See all (48)"
    },
    {
      "id": "activeConversations",
      "pattern": "^([\\d,]+) active conversations$",
      "flags": "i",
      "template": "{1} 個活躍對話",
      "sample": "70 active conversations"
    },
    {
      "id": "tokenUsage",
      "pattern": "^(Rules|Skills|Mcp Tools):\\s*([\\d,]+)\\s*tokens?$",
      "flags": "i",
      "template": "{1}：{2} 個 token",
      "replace": {
        "1": "tokenSection"
      },
      "sample": "Rules: 848 tokens"
    }
  ],
  "valueMaps": {
    "durationUnit": {
      "ms": "毫秒",
      "s": "秒",
      "m": "分鐘",
      "h": "小時"
    },
    "limitType": {
      "weekly limit": "每週限額",
      "5-hour limit": "五小時限額"
    },
    "preset": {
      "Default": "默認",
      "Security Preset": "安全預設",
      "Artifact Review Policy": "Artifact 審查策略",
      "Inherit General": "繼承常規設置"
    },
    "period": {
      ".": "。",
      "": ""
    },
    "tokenSection": {
      "Rules": "規則",
      "Skills": "技能",
      "Mcp Tools": "MCP 工具"
    }
  },
  "valueRules": {
    "timeParts": [
      {
        "pattern": "(\\d+) days?",
        "flags": "g",
        "template": "{1} 天"
      },
      {
        "pattern": "(\\d+) hours?",
        "flags": "g",
        "template": "{1} 小時"
      },
      {
        "pattern": "(\\d+) minutes?",
        "flags": "g",
        "template": "{1} 分鐘"
      },
      {
        "pattern": "(\\d+) seconds?",
        "flags": "g",
        "template": "{1} 秒"
      }
    ]
  },
